#!/usr/bin/env python3

import os
import sys

try:
    import yaml
except ImportError:
    print("Error: PyYAML is not installed. Please install it using 'pip install pyyaml' or run this script within your Ansible Python environment.")
    sys.exit(1)

def extract_hosts(data, current_vars=None):
    if current_vars is None:
        current_vars = {}
    
    hosts = {}
    
    if not isinstance(data, dict):
        return hosts

    # Merge vars at the current level
    if 'vars' in data and isinstance(data['vars'], dict):
        for k, v in data['vars'].items():
            if k in ['ansible_user', 'ansible_host', 'ansible_ssh_private_key_file', 'ansible_port']:
                current_vars[k] = v

    # Process hosts at the current level
    if 'hosts' in data and isinstance(data['hosts'], dict):
        for host_name, host_data in data['hosts'].items():
            if host_name == "localhost":
                continue
                
            host_info = current_vars.copy()
            if isinstance(host_data, dict):
                for k, v in host_data.items():
                    if k in ['ansible_user', 'ansible_host', 'ansible_ssh_private_key_file', 'ansible_port']:
                        host_info[k] = v
            
            # Use ansible_host if defined, otherwise use the host name
            hostname = host_info.get('ansible_host', host_name)
            if hostname == "0.0.0.0":
                continue # Skip unprovisioned hosts
                
            hosts[host_name] = {
                'HostName': hostname,
                'User': host_info.get('ansible_user', 'root'), # Default fallback
            }
            if 'ansible_ssh_private_key_file' in host_info:
                hosts[host_name]['IdentityFile'] = host_info['ansible_ssh_private_key_file']
            if 'ansible_port' in host_info:
                hosts[host_name]['Port'] = host_info['ansible_port']

    # Process children
    if 'children' in data and isinstance(data['children'], dict):
        for child_name, child_data in data['children'].items():
            child_hosts = extract_hosts(child_data, current_vars.copy())
            hosts.update(child_hosts)

    return hosts

def generate_ssh_config(hosts, output_file):
    with open(output_file, 'w') as f:
        f.write("# Automatically generated by ansible-ssh-update tool\n")
        f.write("# Do not edit manually. Changes will be overwritten.\n\n")
        
        for host_name, config in hosts.items():
            f.write(f"Host {host_name}\n")
            for key, value in config.items():
                f.write(f"  {key} {value}\n")
            f.write("\n")

def main():
    if len(sys.argv) < 2:
        print("Usage: ansible-ssh-update <path-to-inventory.yml> [output-ssh-config]")
        sys.exit(1)

    inventory_file = sys.argv[1]
    
    if len(sys.argv) >= 3:
        output_file = sys.argv[2]
    else:
        output_file = os.path.expanduser("~/.ssh/config.d/ansible.conf")
        os.makedirs(os.path.dirname(output_file), exist_ok=True)

    try:
        with open(inventory_file, 'r') as f:
            inventory_data = yaml.safe_load(f)
    except Exception as e:
        print(f"Error reading inventory file: {e}")
        sys.exit(1)

    # Some inventories have an 'all' top level group
    if 'all' in inventory_data:
        inventory_data = inventory_data['all']

    hosts = extract_hosts(inventory_data)
    
    generate_ssh_config(hosts, output_file)
    print(f"Successfully generated SSH config with {len(hosts)} hosts at {output_file}")
    
    # Check if this file is included in main config
    main_config = os.path.expanduser("~/.ssh/config")
    include_line = "Include config.d/*.conf\n"
    
    needs_include = True
    if os.path.exists(main_config):
        with open(main_config, 'r') as f:
            content = f.read()
            if "Include config.d/" in content or "Include ~/.ssh/config.d/" in content:
                needs_include = False
                
    if needs_include:
        print(f"\nNOTE: Please add the following line to the top of your {main_config} file:")
        print(f"Include config.d/*.conf")

if __name__ == "__main__":
    main()
