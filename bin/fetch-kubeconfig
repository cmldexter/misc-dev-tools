#!/bin/bash

TARGET_HOST=${1:-my-k8s-master}
KUBECONFIG_DIR="$HOME/.kube"
KUBECONFIG_PATH="${KUBECONFIG_DIR}/config-${TARGET_HOST}"

mkdir -p "${KUBECONFIG_DIR}"

echo "Fetching RKE2 kubeconfig from ${TARGET_HOST}..."

# Fetch the file securely via SSH, stream it through sed to replace the IP, and write locally
ssh "${TARGET_HOST}" "sudo cat /etc/rancher/rke2/rke2.yaml" | sed "s/127.0.0.1/${TARGET_HOST}/g" > "${KUBECONFIG_PATH}"

# The kubeconfig contains sensitive certificates, so restrict permissions
chmod 600 "${KUBECONFIG_PATH}"

echo "✅ Kubeconfig successfully saved to ${KUBECONFIG_PATH}"
echo ""
echo "To use this configuration for your current session, run:"
echo "export KUBECONFIG=${KUBECONFIG_PATH}"
echo ""
echo "To test connectivity:"
echo "kubectl --kubeconfig=${KUBECONFIG_PATH} get nodes"
