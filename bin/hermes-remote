#!/bin/bash
# hermes-remote — Instant Hermes Agent CLI from any workstation.
#
# Wraps SSH + kubectl exec into a single command so you can interact
# with the Hermes Agent pod without manually chaining connections.
#
# Usage:
#   hermes-remote                        # Interactive REPL (uses AGENT_DEFAULT)
#   hermes-remote --agent anton          # Connect to specific agent container
#   hermes-remote -z "prompt"            # One-shot query
#   hermes-remote --tui                  # TUI mode
#   hermes-remote sessions list          # Any hermes subcommand
#   hermes-remote --shell                # Drop into pod bash (debug)
#
# Configuration (checked in order):
#   1. Environment variables: HERMES_K8S_HOST, HERMES_K8S_USER, HERMES_SSH_KEY
#   2. Config file: ~/.config/hermes-remote.conf
#   3. If neither is set, the script will exit with setup instructions.
#
# Config file format (~/.config/hermes-remote.conf):
#   K8S_HOST=your-k8s-hostname-or-ip
#   K8S_USER=your-ssh-user
#   SSH_KEY=~/.ssh/your-private-key
#   AGENT_DEFAULT=your-default-agent  (e.g., jerome)

CONF_FILE="${HOME}/.config/hermes-remote.conf"

# Load config file if it exists
if [ -f "$CONF_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONF_FILE"
fi

# Env vars take precedence over config file
K8S_HOST="${HERMES_K8S_HOST:-${K8S_HOST:-}}"
K8S_USER="${HERMES_K8S_USER:-${K8S_USER:-}}"
SSH_KEY="${HERMES_SSH_KEY:-${SSH_KEY:-}}"
AGENT_DEFAULT="${HERMES_AGENT_DEFAULT:-${AGENT_DEFAULT:-hermes-agent}}"

if [ -z "$K8S_HOST" ] || [ -z "$K8S_USER" ]; then
  echo "hermes-remote: missing configuration."
  echo ""
  echo "Create ~/.config/hermes-remote.conf:"
  echo "  K8S_HOST=your-k8s-hostname-or-ip"
  echo "  K8S_USER=your-ssh-user"
  echo "  SSH_KEY=~/.ssh/your-private-key"
  echo ""
  echo "Or export environment variables:"
  echo "  export HERMES_K8S_HOST=your-k8s-hostname"
  echo "  export HERMES_K8S_USER=your-ssh-user"
  exit 1
fi

SSH_ARGS=(-tt)
if [ -n "$SSH_KEY" ]; then
  SSH_ARGS+=(-i "$SSH_KEY")
fi

# Parse --agent flag
AGENT="$AGENT_DEFAULT"
if [ "${1:-}" = "--agent" ] || [ "${1:-}" = "-a" ]; then
  if [ -n "${2:-}" ]; then
    AGENT="$2"
    shift 2
  else
    echo "hermes-remote: missing agent name after $1"
    exit 1
  fi
fi

KUBECTL="sudo /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml"

# Dynamically locate which deployment contains the requested agent container
JSON_PATH="{.items[?(@.spec.template.spec.containers[*].name=='$AGENT')].metadata.name}"
FIND_DEPLOY_CMD="$KUBECTL get deploy -n hermes-agent -o jsonpath=\"$JSON_PATH\""

# Execute lookup remotely over SSH
DEPLOY=$(ssh "${SSH_ARGS[@]}" "${K8S_USER}@${K8S_HOST}" "$FIND_DEPLOY_CMD" | tr -d '\r')

if [ -z "$DEPLOY" ]; then
  echo "Error: No deployment found containing agent container: $AGENT"
  exit 1
fi

EXEC_BASE="$KUBECTL exec -it -n hermes-agent deploy/$DEPLOY -c $AGENT --"

# --shell flag: drop into a raw bash shell inside the pod (for debugging)
if [ "${1:-}" = "--shell" ]; then
  ssh "${SSH_ARGS[@]}" "${K8S_USER}@${K8S_HOST}" "$EXEC_BASE bash"
  exit $?
fi

# Normal mode: activate venv and run hermes
ssh "${SSH_ARGS[@]}" "${K8S_USER}@${K8S_HOST}" \
  "$EXEC_BASE bash -c '. /opt/hermes/.venv/bin/activate && hermes $*'"
